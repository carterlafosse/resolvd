# Copy to .env.test and replace every placeholder. Never commit .env.test.
# Points at the separate resolvd_test database so tests never touch development data.
NODE_ENV=test
DATABASE_URL=postgres://resolvd_app:YOUR_APP_PASSWORD@localhost:5432/resolvd_test
MIGRATION_DATABASE_URL=postgres://resolvd_owner:YOUR_OWNER_PASSWORD@localhost:5432/resolvd_test
JWT_SECRET=REPLACE_WITH_48_RANDOM_BYTES_HEX
CLIENT_ORIGIN=http://localhost:5173
SEED_PASSWORD=YOUR_DEMO_PASSWORD
